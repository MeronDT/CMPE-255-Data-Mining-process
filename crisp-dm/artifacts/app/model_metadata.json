{
  "project_name": "Hotel Booking Cancellation Risk",
  "created": "2026-11-06T22:51:24",
  "target": "is_canceled",
  "model_type": "Random Forest + isotonic calibration",
  "parameters": {
    "max_depth": "25",
    "max_features": "sqrt",
    "min_samples_leaf": "5",
    "n_estimators": "150"
  },
  "trained_on": "95,413 bookings arriving 2015-07-01 .. 2017-04-22",
  "decision_threshold": 0.67,
  "overbooking_rule": "for each arrival date, sell extra rooms equal to the rounded sum of the bookings' cancellation probabilities (expected cancellations); bookings above the threshold form a watch list.",
  "test_metrics": {
    "roc_auc": 0.8269,
    "pr_auc": 0.7961,
    "precision": 0.8314,
    "recall": 0.4709,
    "f1": 0.6012,
    "accuracy": 0.7447,
    "brier_raw": 0.168,
    "brier_calibrated": 0.1632
  },
